+func TestBuildProviderRequestTurnsDeepSeekThinkingOffWithNoneEffort(t *testing.T) {
+	// The shape a caller reaches for when it disables thinking on a model whose
+	// roster entry is not adaptive: the shape must not decide this mapping, and
+	// the relay serves the off state as effort=none rather than the roster's own
+	// "off" label.
+	for _, shape := range []thinkingpkg.ModelShape{thinkingpkg.ShapeUnknown, thinkingpkg.ShapeBudget} {
+		body, route, errBuild := buildProviderRequest(pluginapi.ExecutorRequest{
+			Model:        "deepseek-flash",
+			SourceFormat: sdktranslator.FormatOpenAI.String(),
+			Payload:      []byte(`{"model":"deepseek-flash","messages":[{"role":"user","content":"hello"}],"max_tokens":1024,"enable_thinking":false,"reasoning_effort":"none"}`),
+		}, false, shape)
+		if errBuild != nil {
+			t.Fatal(errBuild)
+		}
+		if route.Path != "/v1/messages" || gjson.GetBytes(body, "output_config.effort").String() != "none" || gjson.GetBytes(body, "thinking").Exists() {
+			t.Fatalf("shape %d: body = %s, route = %#v", shape, body, route)
+		}
+	}
+}
