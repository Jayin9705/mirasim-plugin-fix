@@ -0,0 +1,86 @@
+package executor
+
+import (
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/sdk/pluginapi"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	thinkingpkg "github.com/router-for-me/CLIProxyAPIPlugins/mirasim/internal/thinking"
+	"github.com/tidwall/gjson"
+)
+
+func TestEnsureClaudeCodeIdentity(t *testing.T) {
+	tests := []struct {
+		name      string
+		model     string
+		body      string
+		wantTexts []string // nil means the body must come back unchanged
+	}{
+		{name: "no system", model: "claude-opus-5-5", body: `{"model":"claude-opus-5-5"}`, wantTexts: []string{claudeCodeIdentity}},
+		{name: "string system follows the identity", model: "claude-opus-5-5", body: `{"system":"be terse"}`, wantTexts: []string{claudeCodeIdentity, "be terse"}},
+		{name: "empty string system", model: "claude-sonnet-5", body: `{"system":""}`, wantTexts: []string{claudeCodeIdentity}},
+		{name: "array system follows the identity", model: "claude-fable-5-1", body: `{"system":[{"type":"text","text":"a"},{"type":"text","text":"b"}]}`, wantTexts: []string{claudeCodeIdentity, "a", "b"}},
+		{name: "Claude Code array is unchanged", model: "claude-opus-5-5", body: `{"system":[{"type":"text","text":"` + claudeCodeIdentity + `"},{"type":"text","text":"x"}]}`},
+		{name: "Claude Code string is unchanged", model: "claude-opus-5-5", body: `{"system":"` + claudeCodeIdentity + ` more"}`},
+		{name: "prefix and suffix do not hide the family", model: "mirasim/claude-opus-5-5(high)", body: `{}`, wantTexts: []string{claudeCodeIdentity}},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := ensureClaudeCodeIdentity([]byte(test.body), test.model)
+			if test.wantTexts == nil {
+				if string(got) != test.body {
+					t.Fatalf("body changed: %s", got)
+				}
+				return
+			}
+			blocks := gjson.GetBytes(got, "system").Array()
+			if len(blocks) != len(test.wantTexts) {
+				t.Fatalf("system = %s", gjson.GetBytes(got, "system").Raw)
+			}
+			for i, want := range test.wantTexts {
+				if blocks[i].Get("type").String() != "text" || blocks[i].Get("text").String() != want {
+					t.Fatalf("block %d = %s", i, blocks[i].Raw)
+				}
+			}
+		})
+	}
+
+	kept := ensureClaudeCodeIdentity([]byte(`{"system":[{"type":"text","text":"a","cache_control":{"type":"ephemeral"}}]}`), "claude-opus-5-5")
+	if got := gjson.GetBytes(kept, "system.1.cache_control.type").String(); got != "ephemeral" {
+		t.Fatalf("caller block was not kept intact: %s", kept)
+	}
+	for _, model := range []string{"deepseek-flash", "kimi-k3", "glm-5.3-flash", "gpt-5.6-sol"} {
+		if got := ensureClaudeCodeIdentity([]byte(`{"system":"x"}`), model); string(got) != `{"system":"x"}` {
+			t.Fatalf("%s body changed: %s", model, got)
+		}
+	}
+}
+
+func TestBuildProviderRequestAddsClaudeCodeIdentityForOpenAIClients(t *testing.T) {
+	payloads := map[sdktranslator.Format]string{
+		sdktranslator.FormatOpenAIResponse: `{"model":"claude-opus-5-5","input":[{"role":"user","content":[{"type":"input_text","text":"Reply with exactly: pong"}]}],"max_output_tokens":256,"stream":false}`,
+		sdktranslator.FormatOpenAI:         `{"model":"claude-opus-5-5","messages":[{"role":"system","content":"be terse"},{"role":"user","content":"hi"}]}`,
+	}
+	for source, payload := range payloads {
+		body, route, errBuild := buildProviderRequest(pluginapi.ExecutorRequest{
+			Model:        "claude-opus-5-5",
+			SourceFormat: source.String(),
+			Payload:      []byte(payload),
+		}, false, thinkingpkg.ShapeUnknown)
+		if errBuild != nil {
+			t.Fatal(errBuild)
+		}
+		if route.Path != "/v1/messages" || gjson.GetBytes(body, "system.0.text").String() != claudeCodeIdentity {
+			t.Fatalf("%s: body = %s", source, body)
+		}
+	}
+
+	body, _, errBuild := buildProviderRequest(pluginapi.ExecutorRequest{
+		Model:        "deepseek-flash",
+		SourceFormat: sdktranslator.FormatOpenAI.String(),
+		Payload:      []byte(`{"model":"deepseek-flash","messages":[{"role":"user","content":"hi"}]}`),
+	}, false, thinkingpkg.ShapeUnknown)
+	if errBuild != nil || gjson.GetBytes(body, "system").Exists() {
+		t.Fatalf("deepseek gained a system: %s, %v", body, errBuild)
+	}
+}
