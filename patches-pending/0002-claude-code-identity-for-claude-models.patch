index 0000000..2178175
--- /dev/null
+++ b/internal/executor/claude_identity.go
@@ -0,0 +1,59 @@
+package executor
+
+import (
+	"strings"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// claudeCodeIdentity is the system prompt the relay's Claude mount requires.
+// Its Claude models are served on Claude Code subscriptions, so a Messages
+// request whose system does not carry this identity is refused with a bare
+// HTTP 400 ("the request was rejected as invalid") whatever else it holds,
+// while the same request with it is served. Callers that are not Claude Code,
+// such as an OpenAI client translated here, never send it.
+const claudeCodeIdentity = "You are Claude Code, Anthropic's official CLI for Claude."
+
+// ensureClaudeCodeIdentity puts the identity first in system for Claude
+// models, keeping every block the caller sent after it unchanged. A request
+// that already opens with the identity, as Claude Code's own do, is returned
+// as it is.
+func ensureClaudeCodeIdentity(body []byte, model string) []byte {
+	if !strings.HasPrefix(strings.ToLower(normalizeModel(model)), "claude-") {
+		return body
+	}
+	identity, errIdentity := sjson.Set(`{"type":"text"}`, "text", claudeCodeIdentity)
+	if errIdentity != nil {
+		return body
+	}
+	system := gjson.GetBytes(body, "system")
+	blocks := []string{identity}
+	switch {
+	case system.IsArray():
+		existing := system.Array()
+		if len(existing) > 0 && strings.HasPrefix(strings.TrimSpace(existing[0].Get("text").String()), claudeCodeIdentity) {
+			return body
+		}
+		for _, block := range existing {
+			blocks = append(blocks, block.Raw)
+		}
+	case system.Type == gjson.String:
+		text := system.String()
+		if strings.HasPrefix(strings.TrimSpace(text), claudeCodeIdentity) {
+			return body
+		}
+		if strings.TrimSpace(text) != "" {
+			block, errBlock := sjson.Set(`{"type":"text"}`, "text", text)
+			if errBlock != nil {
+				return body
+			}
+			blocks = append(blocks, block)
+		}
+	}
+	updated, errSet := sjson.SetRawBytes(body, "system", []byte("["+strings.Join(blocks, ",")+"]"))
+	if errSet != nil {
+		return body
+	}
+	return updated
+}
diff --git a/internal/executor/claude_identity_test.go b/internal/executor/claude_identity_test.go
