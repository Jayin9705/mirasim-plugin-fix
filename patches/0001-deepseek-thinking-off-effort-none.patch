+func TestDeepSeekDisabledThinkingBecomesNoneEffort(t *testing.T) {
+	// CPA's OpenAI translator turns reasoning_effort=none into this form.
+	body := []byte(`{"model":"deepseek-flash","max_tokens":1024,"thinking":{"type":"disabled"},"messages":[]}`)
+	for _, shape := range []ModelShape{ShapeUnknown, ShapeBudget} {
+		got := NormalizeForWire(body, "deepseek-flash", wireClaude, shape)
+		if gjson.GetBytes(got, "output_config.effort").String() != "none" || gjson.GetBytes(got, "thinking").Exists() {
+			t.Fatalf("shape %d: normalized body = %s", shape, got)
+		}
+	}
+	for _, effort := range []string{"off", "none"} {
+		got := NormalizeForWire([]byte(`{"model":"deepseek-flash","output_config":{"effort":"`+effort+`"}}`), "deepseek-flash", wireClaude, ShapeBudget)
+		if gjson.GetBytes(got, "output_config.effort").String() != "none" || gjson.GetBytes(got, "thinking").Exists() {
